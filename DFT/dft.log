####################################################################################
##################################### UART_CLK ##############################################
set CLK_NAME_UART UART_CLK
set CLK_PER_UART 271.267 
set CLK_SETUP_SKEW 0.20
set CLK_HOLD_SKEW 0.1
set CLK_LAT 0
set CLK_Transition 0.05
create_clock -period "$CLK_PER_UART" -name "$CLK_NAME_UART" [get_ports UART_CLK]
set_clock_uncertainty -setup "$CLK_SETUP_SKEW" [get_clock "$CLK_NAME_UART"]
set_clock_uncertainty -hold "$CLK_HOLD_SKEW" [get_clock "$CLK_NAME_UART"]
set_clock_transition "$CLK_Transition" [get_clock "$CLK_NAME_UART"]
set_dont_touch_network [get_ports UART_CLK]
##################################### REF_CLK ##############################################
set CLK_NAME_REF REF_CLK
set CLK_PER_REF 20 
create_clock -period "$CLK_PER_REF" -name "$CLK_NAME_REF" [get_ports REF_CLK]
set_clock_uncertainty -setup "$CLK_SETUP_SKEW" [get_clock "$CLK_NAME_REF"]
set_clock_uncertainty -hold "$CLK_HOLD_SKEW" [get_clock "$CLK_NAME_REF"]
set_clock_transition "$CLK_Transition" [get_clock "$CLK_NAME_REF"]
set_dont_touch_network [get_ports REF_CLK]
#################################### scan_clk ############################################
set CLK_NAME_scan scan_clk
set CLK_PER_scan 100
create_clock -period "$CLK_PER_scan" -name "$CLK_NAME_scan" [get_ports scan_clk]
set_clock_uncertainty -setup "$CLK_SETUP_SKEW" [get_clock "$CLK_NAME_scan"]
set_clock_uncertainty -hold "$CLK_HOLD_SKEW" [get_clock "$CLK_NAME_scan"]
set_clock_transition "$CLK_Transition" [get_clock "$CLK_NAME_scan"]
set_dont_touch_network [get_ports scan_clk]
####################################################################################
#########################################################
#### Section 2 : Clocks Relationships ####
#########################################################
####################################################################################
###  RX_CLK
create_generated_clock -master_clock "$CLK_NAME_UART"                        -source [get_ports UART_CLK]                        -name RX_CLK                        -divide_by 1                        [get_pins Domain_2_TOP_U1/ClkDiv_U2_RX/o_div_clk]
### TX_CLK
create_generated_clock -master_clock "$CLK_NAME_UART"                        -source [get_ports "$CLK_NAME_UART"]                        -name "TX_CLK" -divide_by 32                       [get_pins Domain_2_TOP_U1/ClkDiv_U1_TX/o_div_clk]
########################################### logically exclusive ##############################
set_clock_groups -physically_exclusive -group [get_clocks scan_clk] -group [get_clocks REF_CLK]
set_clock_groups -physically_exclusive -group [get_clocks scan_clk] -group [get_clocks UART_CLK]
set_clock_groups -physically_exclusive -group [get_clocks scan_clk] -group [get_clocks RX_CLK]
set_clock_groups -physically_exclusive -group [get_clocks scan_clk] -group [get_clocks TX_CLK]
